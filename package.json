{
  "name": "partnerlink",
  "version": "1.0.0",
  "description": "GIKI-exclusive FYP partner discovery platform",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm run setup --prefix backend",
    "install:all": "npm-run-all install:frontend install:backend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
